APP_NAME="AI Hiring Dev"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# For IP-only HTTP, use http://VPS_IP and set SESSION_SECURE_COOKIE=false below.
APP_URL=https://dev.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_hiring_dev
DB_USERNAME=ai_hiring_dev
DB_PASSWORD="REPLACE_ON_SERVER"
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
CACHE_STORE=database

# Dev mail stays in storage/logs rather than reaching real recipients.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
