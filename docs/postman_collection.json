{
  "info": {
    "_postman_id": "75d5f4f0-d49a-4f91-a490-368ad98c12ac",
    "name": "Roku - Secure LLM Chat API Hub",
    "description": "Koleksi Postman untuk pengujian dan demonstrasi fitur Secure LLM Chat API Hub pada aplikasi Roku (AI Hiring Agent).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login (Dapatkan Token Sanctum)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Respons berstatus success\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "});",
              "",
              "if (jsonData.status === \"success\" && jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
              "    console.log(\"Token Sanctum tersimpan otomatis ke variabel koleksi.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman-demo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Autentikasi akun demo untuk memperoleh plain-text token Sanctum yang disimpan otomatis ke variabel koleksi."
      },
      "response": []
    },
    {
      "name": "2. Chat AI Tanpa Token (401 Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Respons mengembalikan format error terstruktur\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"error\");",
              "    pm.expect(jsonData.message).to.be.a(\"string\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Halo, apakah saya bisa mengakses chat ini tanpa token autentikasi?\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat-ai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "Menguji proteksi middleware auth:sanctum ketika request tidak menyertakan Authorization Bearer token."
      },
      "response": []
    },
    {
      "name": "3. Chat AI Input Tidak Valid (422 Unprocessable Content)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 422 Unprocessable Content\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Respons error validasi Bahasa Indonesia\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"error\");",
              "    pm.expect(jsonData.errors).to.have.property(\"prompt\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat-ai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "Menguji validasi FormRequest ChatAiRequest ketika prompt dikosongkan."
      },
      "response": []
    },
    {
      "name": "4. Chat AI Sukses (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Struktur JSON sesuai kontrak baku rubrik\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "    pm.expect(jsonData.data).to.have.property(\"session_id\");",
              "    pm.expect(jsonData.data).to.have.property(\"model_used\");",
              "    pm.expect(jsonData.data).to.have.property(\"prompt\");",
              "    pm.expect(jsonData.data).to.have.property(\"ai_response\");",
              "    pm.expect(jsonData.data).to.have.property(\"timestamp\");",
              "});",
              "",
              "if (jsonData.data && jsonData.data.session_id) {",
              "    pm.collectionVariables.set(\"session_id\", jsonData.data.session_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Jelaskan peran penting seorang Senior Backend Engineer dalam arsitektur rekrutmen berbasis AI!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat-ai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat-ai"
          ]
        },
        "description": "Menguji pengiriman prompt ke LLM secara sinkron, verifikasi injeksi system prompt, dan penyimpanan ke chat_logs serta chat_messages."
      },
      "response": []
    },
    {
      "name": "5. Chat AI Streaming (200 SSE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type adalah text/event-stream\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/event-stream\");",
              "});",
              "",
              "pm.test(\"Respons SSE mengandung event chunk\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"data: {\\\"chunk\\\":\");",
              "});",
              "",
              "pm.test(\"Respons SSE diakhiri penanda [DONE]\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"[DONE]\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/event-stream"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Sebutkan 3 kriteria utama dalam mengevaluasi CV seorang Software Architect!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/chat-ai/stream",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat-ai",
            "stream"
          ]
        },
        "description": "Menguji respons streaming SSE (Server-Sent Events) bertahap: event data chunk, event metadata berisi status [DONE], dan baris penutup data: [DONE]. Jika penyedia gagal setelah potongan pertama, server mengirim event error dengan pesan generik dan tidak melanjutkan dengan penyedia lain."
      },
      "response": []
    },
    {
      "name": "6. Riwayat Chat Pengguna (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Riwayat hanya berisi data pengguna yang login\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Setiap entri memakai kontrak baku\", function () {",
              "    jsonData.data.forEach(function (item) {",
              "        pm.expect(item).to.have.property(\"session_id\");",
              "        pm.expect(item).to.have.property(\"model_used\");",
              "        pm.expect(item).to.have.property(\"prompt\");",
              "        pm.expect(item).to.have.property(\"ai_response\");",
              "        pm.expect(item).to.have.property(\"timestamp\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/chat-ai/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "chat-ai",
            "history"
          ]
        },
        "description": "Mengambil maksimal 50 entri chat_logs terbaru milik pengguna yang login. Tambahkan query session_id untuk memfilter satu sesi. Session milik pengguna lain menghasilkan HTTP 422."
      },
      "response": []
    },
    {
      "name": "7. Logout (Revoke Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code adalah 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "pm.test(\"Token berhasil dicabut\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"success\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        },
        "description": "Mencabut token Sanctum yang sedang aktif. Token yang sudah dicabut akan ditolak dengan HTTP 401 pada permintaan berikutnya."
      },
      "response": []
    }
  ]
}
